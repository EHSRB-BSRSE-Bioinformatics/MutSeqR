# Manual upstream patch: retain model-averaged bootstrap curve coordinates
#
# This is intentionally organized by function rather than by file because
# R/proast.min.R is generated from separate upstream function files.
# It is a patching guide, not a patch intended for `git apply` as-is.
#
# Public option:
#   return_bootstrap_curves = FALSE
#
# Stored result when enabled:
#   ans.all$MA$bootstrap_curves
#
# Columns:
#   bootstrap, model, covariate, dose, response
#
# The authoritative bootstrap curve is the AIC-weighted `yy.ma.plt` calculated
# by f.ced.ma(). `lines.plt.lst` is the selected-model curve and is not the
# curve drawn by the "bootstrap curves based on model averaging" plot.


# diff for function f.proast()

# Add at the end of the function signature to preserve positional calls:
#
# - seed = 125)
# + seed = 125,
# + return_bootstrap_curves = FALSE)
#
# Add the following roxygen parameter:
#
# + @param return_bootstrap_curves Logical. If TRUE, retain tidy numeric
# + coordinates for each model-averaged bootstrap curve. Defaults to FALSE.
#
# Pass the option to every f.con() call:
#
#   f.con(
#     ...,
# +   return_bootstrap_curves = return_bootstrap_curves
#   )


